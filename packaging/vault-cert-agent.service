[Unit]
Description=Renew TLS material from Vault
Documentation=https://github.com/ophymx/vault-cert-agent
# network-online ensures DNS + routing are usable before the Vault
# round-trip. Without it the first post-boot run can race the network.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/vault-cert-agent
# Runs as root: needs to chown cert files to per-consumer owners
# (postgres, haproxy, etc.) and write under /etc/<consumer>/.
User=root
Group=root
# Bound generously — Vault calls + reloads should finish in seconds,
# but pathological DNS could stretch a run.
TimeoutStartSec=120s

# ─── Sandboxing ──────────────────────────────────────────────────
# The agent runs as root so most isolation primitives can't shrink
# its blast radius much, but the following stop a compromise from
# escalating into a broader system foothold without breaking the
# agent's actual workload (writing under /etc/<consumer>/, calling
# Vault, talking to systemd via D-Bus, exec'ing a reload command).
#
# ProtectSystem=true mounts /usr and /boot read-only; /etc stays
# writable so per-cert destinations (e.g. /etc/haproxy/certs/) work
# without enumerating them in ReadWritePaths.
# (=full would also mount /etc read-only, which breaks the writer.
#  =strict would mount the whole hierarchy read-only.)
ProtectSystem=true
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
